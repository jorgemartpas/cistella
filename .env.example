# Copia este archivo a .env.local y rellénalo. Nunca subas claves reales al repositorio.

# ─── Supabase (Project Settings → API) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon o publishable)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (service_role o secret). Solo servidor: cron, webhooks y alta de tiendas.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la web (para los enlaces de los emails y la vuelta de Stripe).
# En Vercel es opcional: si no está, se usa la dirección de producción del proyecto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto que Vercel Cron envía como "Authorization: Bearer ..." al endpoint de cierre de pedidos
CRON_SECRET=

# ─── Stripe (siempre en modo test hasta el lanzamiento: claves sk_test_…) ──
STRIPE_SECRET_KEY=
# Precio recurrente de 20 €/mes. Créalo con: npm run stripe:setup
STRIPE_PRICE_ID=
# Secreto del endpoint /api/stripe/webhook (Dashboard → Developers → Webhooks, o `stripe listen`)
STRIPE_WEBHOOK_SECRET=
